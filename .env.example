APP_NAME=Spotiko
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:1111

# React SPA origin(s). FRONTEND_URL is where the Spotify OAuth callback
# redirects back to; SANCTUM_STATEFUL_DOMAINS must list every host:port the
# browser actually uses (apache-served build AND the Vite dev server) or
# Sanctum will not attach session cookies to API requests from it.
FRONTEND_URL=http://localhost:1111
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:1111,localhost:5173,127.0.0.1,127.0.0.1:1111,127.0.0.1:5173
SESSION_DOMAIN=localhost

# Seeded by database/seeders/AdminUserSeeder.php
ADMIN_EMAIL=
ADMIN_PASSWORD=

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=spotiko
DB_USERNAME=spotiko
DB_PASSWORD=sa

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Defaults to {APP_URL}/api/spotify/callback — must match the Spotify
# Developer Dashboard's registered redirect URI.
SPOTIFY_REDIRECT_URI=

LINE_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
